<?php
/** @var AiAssistantExtension $this */
$assistantUrl = (string) ($this->getUserConfigurationValue('assistant_url') ?? '');
$assistantToken = (string) ($this->getUserConfigurationValue('assistant_token') ?? '');
$assistantPublicUrl = (string) ($this->getUserConfigurationValue('assistant_public_url') ?? '');
$formAction = _url('extension', 'configure', 'e', $this->getName());
$csrfToken = FreshRSS_Auth::csrfToken();
?>

<div class="panel panel-default">
	<div class="panel-heading">
		<h3>AI Assistant</h3>
	</div>
	<div class="panel-body">
		<p class="help-block">
			Scoring, summaries, briefs and chat run in the <strong>assistant</strong> service. Interest profile,
			models and per-feed rules are configured there.
			<?php if ($this->publicUrl !== '') { ?>
				<a class="btn btn-primary" href="<?= _url('assistant', 'index') ?>">Open the assistant</a>
			<?php } ?>
		</p>
		<p>
			<button type="button" id="ai-test-service" class="btn btn-default">Test connection</button>
			<span id="ai-test-result" style="margin-left: 8px;"></span>
		</p>

		<form method="post" action="<?= $formAction ?>">
			<input type="hidden" name="_csrf" value="<?= htmlspecialchars($csrfToken) ?>">

			<div class="form-group">
				<label for="assistant_url">Service URL (internal)</label>
				<p class="help-block">Currently using <code><?= htmlspecialchars($this->serviceUrl) ?></code>. Leave empty to use the <code>ASSISTANT_URL</code> environment variable.</p>
				<input type="text" id="assistant_url" name="assistant_url" class="form-control" value="<?= htmlspecialchars($assistantUrl) ?>" placeholder="http://assistant:8000">
			</div>

			<div class="form-group">
				<label for="assistant_token">Internal token</label>
				<p class="help-block">
					<?php if ($this->tokenFromEnv) { ?>Set from the <code>ASSISTANT_INTERNAL_TOKEN</code> environment variable. Leave empty unless you need to override it.<?php }
					elseif (!$this->tokenConfigured) { ?><strong>Not configured.</strong> Set <code>ASSISTANT_INTERNAL_TOKEN</code> in the deploy <code>.env</code> (same value for both containers) or paste it here.<?php }
					else { ?>Configured here (overrides the environment variable).<?php } ?>
				</p>
				<input type="password" id="assistant_token" name="assistant_token" class="form-control" value="<?= htmlspecialchars($assistantToken) ?>" autocomplete="off">
			</div>

			<div class="form-group">
				<label for="assistant_public_url">Assistant UI URL (for the "Open the assistant" link)</label>
				<input type="text" id="assistant_public_url" name="assistant_public_url" class="form-control" value="<?= htmlspecialchars($assistantPublicUrl) ?>" placeholder="http://freshrss.yuffie.ts.net:8081">
			</div>

			<button type="submit" class="btn btn-primary">Save</button>
		</form>
	</div>
</div>

<script>
document.getElementById('ai-test-service').addEventListener('click', function () {
	var btn = this, out = document.getElementById('ai-test-result');
	btn.disabled = true; out.textContent = 'Testing…'; out.style.color = '';
	var url = new URL(window.location.pathname, window.location.origin);
	url.searchParams.set('c', 'extension'); url.searchParams.set('a', 'configure');
	url.searchParams.set('e', 'AI Assistant'); url.searchParams.set('ajax_action', 'test_service');
	fetch(url.toString(), { method: 'POST', headers: { 'Content-Type': 'application/json; charset=UTF-8' },
		body: JSON.stringify({ ajax: true, _csrf: context.csrf }) })
		.then(function (r) { return r.json(); })
		.then(function (d) { out.textContent = d.message; out.style.color = d.status === 'ok' ? '#22c55e' : '#ef4444'; })
		.catch(function () { out.textContent = 'Request failed'; out.style.color = '#ef4444'; })
		.finally(function () { btn.disabled = false; });
});
</script>
