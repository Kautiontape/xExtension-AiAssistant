			<code>.env</code> or fill it in under Extensions → AI Assistant.
		</p>
	<?php } else { ?>
		<div class="ai-assistant-page-bar">
			<a class="btn" href="<?= htmlspecialchars($this->publicUrl) ?>" target="_blank" rel="noopener">Open in a new tab</a>
		</div>
		<iframe id="ai-assistant-frame" src="<?= htmlspecialchars($this->assistantUrl) ?>" title="News Assistant" allow="clipboard-write"></iframe>
	<?php } ?>
</div>
